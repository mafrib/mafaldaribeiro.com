---
interface Props { variant?: 'editorial' | 'grafica'; linked?: boolean; }
const { variant = 'editorial', linked = false } = Astro.props;
const organisations: Record<string, string> = {
  'Cloudflare': 'https://www.cloudflare.com/',
  'Jane Street': 'https://www.janestreet.com/',
  'Instituto Superior Técnico': 'https://tecnico.ulisboa.pt/en/',
  'NEIIST': 'https://neiist.tecnico.ulisboa.pt/',
};
const courses: Record<string, string> = {
  '2023-09': 'https://tecnico.ulisboa.pt/en/education/courses/masters-programmes/computer-science-and-engineering/',
  '2020-09': 'https://tecnico.ulisboa.pt/en/education/courses/undergraduate-programmes/computer-science-and-engineering/',
};
// Dates and role titles follow the LinkedIn text supplied by Mafalda.
const entries = [
  { name: 'Cloudflare', from: 'Nov 2025', to: 'Present', start: '2025-11', end: null, title: 'Technical Program Manager', note: 'Security team', current: true },
  { name: 'Cloudflare', from: 'Jun 2025', to: 'Nov 2025', start: '2025-06', end: '2025-11', title: 'Cybersecurity Technical Program Manager Intern' },
  { name: 'Jane Street', from: 'Jun 2024', to: 'Sep 2024', start: '2024-06', end: '2024-09', title: 'IT Operations Intern (Summer 2024)', note: 'London' },
  { name: 'Instituto Superior Técnico', from: 'Sep 2023', to: 'Oct 2025', start: '2023-09', end: '2025-10', title: "Master's degree, Computer Science and Engineering", education: true },
  { name: 'Instituto Superior Técnico', from: 'Oct 2022', to: 'Jun 2025', start: '2022-10', end: '2025-06', title: 'User Support Student Grantee', note: 'DSI / IT Services · Part-time' },
  { name: 'NEIIST', from: 'Feb 2021', to: 'Sep 2024', start: '2021-02', end: '2024-09', title: 'Computer Science Students Group', roles: [
    { title: 'President', dates: 'Sep 2023 - Sep 2024' },
    { title: 'Board Member', dates: 'Aug 2022 - Sep 2024' },
    { title: 'Visuals Team Coordinator', dates: 'Aug 2022 - Sep 2024' },
    { title: 'Visuals Team Collaborator', dates: 'Feb 2021 - Sep 2024' },
  ] },
  { name: 'Instituto Superior Técnico', from: 'Sep 2020', to: 'Jun 2023', start: '2020-09', end: '2023-06', title: "Bachelor's degree, Computer Science and Engineering", education: true },
];
---
<section aria-label="Experience and education" class:list={['career', variant, { linked }]}>
  <ol class="timeline" role="list">
    {entries.map((entry, index) => <li class:list={['milestone', { current: entry.current, education: entry.education, community: !!entry.roles }]}>
      <div class="period">
        {(!index || entries[index - 1].start.slice(0, 4) !== entry.start.slice(0, 4)) && <span class="year" aria-hidden="true">{entry.start.slice(0, 4)}</span>}
        <span class="dates"><time datetime={entry.start}>{entry.from}</time><span aria-hidden="true"> - </span><span class="sr-only"> to </span>{entry.end ? <time datetime={entry.end}>{entry.to}</time> : <span>{entry.to}</span>}</span>
      </div>
      <span class="point" aria-hidden="true"></span>
      <div class="milestone-content">
        {variant === 'grafica' && <p class="category">{entry.education ? 'Education' : entry.roles ? 'Student community' : 'Work'}</p>}
        <h2>{linked ? <a href={organisations[entry.name]}>{entry.name}</a> : entry.name}</h2>
        <p class="position">{linked && entry.education ? <a href={courses[entry.start]}>{entry.title}</a> : entry.title}</p>
        {entry.note && <p class="note">{linked && entry.start === '2022-10' ? <><a href="https://si.tecnico.ulisboa.pt/">DSI / IT Services</a> · Part-time</> : entry.note}</p>}
        {entry.roles && <dl class="roles">
          {entry.roles.map(role => <div><dt>{role.title}</dt><dd>{role.dates}</dd></div>)}
        </dl>}
      </div>
    </li>)}
  </ol>
</section>
<style>
  .career { border-top: 1px solid var(--line); padding-top: 2.5rem; }
  .timeline { margin: 0; padding: 0; list-style: none; }
  .milestone { position: relative; display: grid; grid-template-columns: 11.5rem minmax(0, 1fr); gap: 3rem; }
  .milestone::before { content: ''; position: absolute; left: 13rem; width: 1px; top: 0; bottom: 0; background: var(--line); }
  .milestone:first-child::before { top: 16px; }
  .milestone:last-child::before { bottom: auto; height: 16px; }
  .point { position: absolute; left: calc(13rem - 5px); top: 11px; width: 11px; height: 11px; border: 1px solid var(--line); border-radius: 50%; background: var(--paper); }
  .current .point { background: var(--accent); border-color: var(--accent); }
  .period { margin: 5px 0 0; font-family: Arial, sans-serif; font-size: 0.875rem; line-height: 1.6; color: var(--muted); text-align: right; }
  .current .period { color: var(--accent); }
  .milestone-content { padding-bottom: 2.5rem; }
  .milestone:last-child .milestone-content { padding-bottom: 0; }
  h2 { font-size: 1.75rem; margin: 0; line-height: 1.2; }
  .current h2 { color: var(--accent); }
  .position { font-size: 1.0625rem; margin: 0.5rem 0 0; line-height: 1.6; }
  .note { font-size: 0.9375rem; color: var(--muted); margin: 0.3rem 0 0; }
  .roles { margin: 1rem 0 0; }
  .roles > div { display: grid; grid-template-columns: minmax(0, 1fr) 11rem; gap: 0.5rem 1.5rem; padding-block: 0.5rem; max-width: 40rem; }
  dt { font-size: 0.9375rem; }
  dd { margin: 0; font-family: Arial, sans-serif; font-size: 0.8125rem; color: var(--muted); line-height: 1.8; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .year { display: block; font-family: 'Proposal DM Serif', Georgia, serif; font-style: italic; font-size: 4.5rem; line-height: 1; margin-bottom: 0.75rem; color: var(--accent); }
  .dates { display: block; }
  .editorial .milestone { min-height: 170px; }
  .editorial h2 { font-size: 2.5rem; }
  .editorial .milestone-content { padding-top: 0.5rem; padding-bottom: 3rem; }
  .editorial .current h2 { color: var(--ink); }
  .grafica { --line: #a6b5ad; }
  .grafica .milestone { grid-template-columns: 9rem minmax(0, 1fr); gap: 3rem; }
  .grafica .milestone::before { left: 10.5rem; }
  .grafica .point { left: calc(10.5rem - 6px); width: 13px; height: 13px; border-color: #326451; }
  .grafica .education .point { border-radius: 0; background: #dce8df; }
  .grafica .community .point { border-radius: 0; transform: rotate(45deg); background: var(--paper); }
  .grafica .year { font-size: 2.5rem; color: #326451; font-style: normal; }
  .grafica .category { color: #326451; font-family: Arial, sans-serif; font-size: 0.8125rem; margin: 0 0 0.75rem; }
  .grafica .milestone-content { padding-bottom: 2rem; }
  .grafica h2 { font-family: 'Proposal Lora', Georgia, serif; font-size: 1rem; color: var(--muted); }
  .grafica .position { font-family: 'Proposal DM Serif', Georgia, serif; font-size: 1.75rem; line-height: 1.25; max-width: 30ch; }
  .grafica .current .position { color: var(--accent); }
  .grafica .roles { border-top: 1px solid #c5d2cb; padding-top: 0.5rem; }
  .linked .period, .linked dd { font-family: 'Proposal Lora', Georgia, serif; }
  .linked a { text-decoration: underline; text-decoration-color: #b58a95; text-decoration-thickness: 1px; text-underline-offset: 5px; }
  .linked a:hover, .linked a:focus-visible { color: var(--accent); text-decoration-color: currentColor; }
  @media (max-width: 700px) {
    .career { padding-top: 2rem; }
    .milestone { grid-template-columns: minmax(0, 1fr); gap: 0.5rem; padding-left: 2rem; }
    .milestone::before { left: 5px; }
    .point { left: 0; }
    .period { text-align: left; font-size: 0.8125rem; }
    .milestone-content { padding-bottom: 2rem; }
    h2 { font-size: 1.5rem; }
    .position { font-size: 1rem; }
    .roles > div { grid-template-columns: minmax(0, 1fr); gap: 0.1rem; }
    .year { font-size: 3rem; margin-bottom: 0.5rem; }
    .editorial h2 { font-size: 1.875rem; }
    .editorial .milestone { min-height: 0; }
    .editorial .milestone-content { padding-top: 0; padding-bottom: 2.5rem; }
    .grafica .milestone { grid-template-columns: minmax(0, 1fr); gap: 0.75rem; }
    .grafica .milestone::before { left: 5px; }
    .grafica .point { left: -1px; }
    .grafica .year { font-size: 2rem; }
    .grafica .position { font-size: 1.5rem; }
  }
</style>
