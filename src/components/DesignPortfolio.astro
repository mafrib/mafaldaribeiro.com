---
import DesignChapter from './DesignChapter.astro';
import DesignPreview from './DesignPreview.astro';
import groups from '../data/design-studies.json';
---
  <article class="design-portfolio">
    <header class="intro">
      <h1>Design &amp; multimedia</h1>
      <p>My master's thesis, selected design coursework and visual work for <a href="https://neiist.tecnico.ulisboa.pt/">NEIIST</a>.</p>
    </header>
    <div class="body-layout">
      <nav class="chapter-index" aria-label="Projects, courses and NEIIST">
        <a href="#crypto-books"><span>01</span>Master's thesis</a>
        {groups.map((group, index) => <a href={`#${group.id}`}><span>{String(index + 2).padStart(2, '0')}</span>{group.name}</a>)}
      </nav>
      <div class="chapters">
        <section class="chapter thesis" id="crypto-books" aria-labelledby="crypto-books-title">
          <header class="chapter-heading">
            <h2 id="crypto-books-title">Crypto-Books</h2>
            <p>Master's thesis · 2025</p>
          </header>
          <a class="thesis-preview" href="https://crypto-books.mafaldaribeiro.pt/" target="_blank" rel="noopener noreferrer" aria-label="Open Crypto-Books interactive project (opens in a new tab)">
            <img src="/content/images/previews/crypto-books.webp" width="1920" height="1333" alt="Crypto-Books dashboard showing a map of authors, relationships between royal libraries, literary categories and a catalogue of books." />
          </a>
          <div class="thesis-description">
            <p>I designed and developed an interactive tool for exploring the book collections of Portugal's Avis royal dynasty, combining information visualization, iterative prototyping and user testing.</p>
            <p>Developed as my master's thesis at <a href="https://tecnico.ulisboa.pt/en/">Instituto Superior Técnico</a>, in collaboration with the <a href="https://www.chul.letras.ulisboa.pt/">Centre for History</a> at the University of Lisbon's <a href="https://www.letras.ulisboa.pt/">School of Arts and Humanities (FLUL)</a>.</p>
            <a class="project-link" href="https://crypto-books.mafaldaribeiro.pt/" target="_blank" rel="noopener noreferrer" aria-label="Open interactive project (opens in a new tab)">Open interactive project <span aria-hidden="true">↗</span></a>
          </div>
        </section>
        {groups.map(group => <section class="chapter" id={group.id}>
        <header class="chapter-heading"><h2>{group.name}</h2>{group.year && <p>{group.year}</p>}</header>
        <DesignChapter group={group} />
      </section>)}</div>
    </div>
  </article>
  <DesignPreview />
<style>
  .design-portfolio { padding-bottom: 5rem; }
  .intro { padding-block: 3rem 2.5rem; }
  .intro h1 { max-width: 55rem; }
  .intro p { max-width: 46rem; font-size: 1.125rem; line-height: 1.7; color: var(--muted); }
  .body-layout { display: grid; grid-template-columns: 13rem minmax(0, 1fr); gap: 3rem; }
  .chapter-index { position: sticky; top: 2rem; align-self: start; display: grid; gap: 0.75rem; }
  .chapter-index a { display: grid; grid-template-columns: 1.5rem 1fr; gap: 0.5rem; text-decoration: none; font-size: 1.0625rem; line-height: 1.5; padding-block: 0.35rem; }
  .chapter-index a:hover, .chapter-index a:focus-visible { color: var(--accent); text-decoration: underline; }
  .chapter-index span { color: var(--accent); font-style: italic; }
  .chapter { border-top: 1px solid var(--line); padding-block: 2rem 3.5rem; scroll-margin-top: 1.5rem; }
  .chapter-heading { margin-bottom: 2rem; }
  h2 { font-size: 2rem; margin: 0; }
  .chapter-heading p { color: var(--muted); margin: 0.75rem 0 0; font-size: 1.125rem; }
  .thesis-preview { display: block; }
  .thesis-preview img { display: block; width: 100%; height: auto; }
  .thesis-description { margin-top: 1.5rem; max-width: 46rem; }
  .thesis-description p { font-size: 1rem; line-height: 1.75; margin: 0 0 1rem; }
  .thesis-description p + p { color: var(--muted); }
  @media (max-width: 1000px) {
    .body-layout { grid-template-columns: 11rem minmax(0, 1fr); gap: 1.75rem; }
  }
  @media (max-width: 760px) {
    .body-layout { display: block; }
    .chapter-index { position: static; padding-bottom: 2rem; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem; }
  }
  @media (max-width: 480px) {
    .chapter-index { grid-template-columns: 1fr; }
    h2 { font-size: 1.75rem; }
  }
</style>
