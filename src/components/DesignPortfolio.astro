---
import DesignChapter from './DesignChapter.astro';
import DesignPreview from './DesignPreview.astro';
import groups from '../data/design-studies.json';
---
  <article class="design-portfolio">
    <header class="intro">
      <h1>Design &amp; multimedia</h1>
      <p>A few projects I made while exploring an interest in design, through coursework and <a href="https://neiist.tecnico.ulisboa.pt/">NEIIST</a>.</p>
    </header>
    <div class="body-layout">
      <nav class="chapter-index" aria-label="Courses and NEIIST">{groups.map((group, index) => <a href={`#${group.id}`}><span>0{index + 1}</span>{group.name}</a>)}</nav>
      <div class="chapters">{groups.map(group => <section class="chapter" id={group.id}>
        <header class="chapter-heading"><h2>{group.name}</h2>{group.year && <p>{group.year}</p>}</header>
        <DesignChapter group={group} />
      </section>)}</div>
    </div>
  </article>
  <DesignPreview />
<style>
  .design-portfolio { padding-bottom: 5rem; }
  .intro { padding-block: 3rem 2.5rem; }
  .intro h1 { max-width: 55rem; }
  .intro p { max-width: 46rem; font-size: 1.125rem; line-height: 1.7; color: var(--muted); }
  .body-layout { display: grid; grid-template-columns: 13rem minmax(0, 1fr); gap: 3rem; }
  .chapter-index { position: sticky; top: 2rem; align-self: start; display: grid; gap: 0.75rem; }
  .chapter-index a { display: grid; grid-template-columns: 1.5rem 1fr; gap: 0.5rem; text-decoration: none; font-size: 1.0625rem; line-height: 1.5; padding-block: 0.35rem; }
  .chapter-index a:hover, .chapter-index a:focus-visible { color: var(--accent); text-decoration: underline; }
  .chapter-index span { color: var(--accent); font-style: italic; }
  .chapter { border-top: 1px solid var(--line); padding-block: 2rem 3.5rem; scroll-margin-top: 1.5rem; }
  .chapter-heading { margin-bottom: 2rem; }
  h2 { font-size: 2rem; margin: 0; }
  .chapter-heading p { color: var(--muted); margin: 0.75rem 0 0; font-size: 1.125rem; }
  @media (max-width: 1000px) {
    .body-layout { grid-template-columns: 11rem minmax(0, 1fr); gap: 1.75rem; }
  }
  @media (max-width: 760px) {
    .body-layout { display: block; }
    .chapter-index { position: static; padding-bottom: 2rem; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem; }
  }
  @media (max-width: 480px) {
    .chapter-index { grid-template-columns: 1fr; }
    h2 { font-size: 1.75rem; }
  }
</style>
