---
interface Props {
  title: string;
  source: string;
}
const { title, source } = Astro.props;
---
<div class="interactive-project">
  <iframe src={source} title={`${title} interactive prototype`} loading="lazy" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>
</div>
<style>
  .interactive-project { width: min(100%, 28rem); height: 40rem; max-height: 80svh; margin-bottom: 0.75rem; }
  iframe { display: block; width: 100%; height: 100%; border: 0; background: var(--paper); }
</style>
