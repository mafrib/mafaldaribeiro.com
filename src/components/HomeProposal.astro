---
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
interface Props {
  variant: 'literaria' | 'grafica' | 'delicada' | 'editorial';
  typography?: 'humanista' | 'classica';
}
const { variant, typography = 'humanista' } = Astro.props;
---

<div class:list={['proposal', variant, typography]}>
  {variant === 'editorial' && typography === 'classica' ? <SiteHeader /> : <header>
    {variant === 'editorial' && <a class="home-link" href="/" aria-label="Mafalda Ribeiro home" aria-current="page">m<span aria-hidden="true">.</span></a>}
    {variant !== 'editorial' && <a class="monogram" href="/" aria-label="Mafalda Ribeiro home">mr<span aria-hidden="true">.</span></a>}
    <nav aria-label="Main navigation">
      <a href="/about/">About</a>
      <a href="/photography/">Photography</a>
    </nav>
  </header>}
  <main>
    <h1><span>Mafalda</span> <span>Ribeiro<span class="period" aria-hidden="true">.</span></span></h1>
    <p>Technical Program Manager <span class="employer">@ <a class="company-link" href="https://www.cloudflare.com/">Cloudflare</a></span></p>
  </main>
  {variant === 'editorial' ? <SiteFooter /> : <footer>
    <nav class="contacts" aria-label="Social links">
      <a href="https://www.linkedin.com/in/mafrib" aria-label="LinkedIn" title="LinkedIn">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.9 8.9H3.7v10.4h3.2V8.9ZM5.3 7.5a1.9 1.9 0 1 0 0-3.8 1.9 1.9 0 0 0 0 3.8ZM20.3 13.4c0-3.1-1.6-4.8-4.1-4.8-1.9 0-2.8 1.1-3.3 1.8V8.9H9.8v10.4H13v-5.8c0-1.5.8-2.3 2-2.3s2 .8 2 2.3v5.8h3.2v-5.9Z" /></svg>
      </a>
      <a href="https://github.com/mafrib" aria-label="GitHub" title="GitHub">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.8a9.2 9.2 0 0 0-2.9 17.9c.5.1.7-.2.7-.5v-1.8c-2.9.6-3.5-1.2-3.5-1.2-.5-1.1-1.1-1.4-1.1-1.4-.9-.6.1-.6.1-.6 1 0 1.6 1.1 1.6 1.1.9 1.6 2.5 1.1 3 .8.1-.7.4-1.1.7-1.4-2.3-.3-4.7-1.2-4.7-5.1 0-1.1.4-2.1 1.1-2.8-.1-.3-.5-1.3.1-2.8 0 0 .9-.3 2.9 1.1a10 10 0 0 1 5.2 0C17.2 4.7 18.1 5 18.1 5c.6 1.5.2 2.5.1 2.8.7.7 1.1 1.7 1.1 2.8 0 3.9-2.4 4.8-4.7 5.1.4.3.7 1 .7 2v2.5c0 .3.2.6.7.5A9.2 9.2 0 0 0 12 2.8Z" /></svg>
      </a>
    </nav>
    <small>&copy; {new Date().getFullYear()} Mafalda Ribeiro</small>
  </footer>}
</div>

<style>
  @font-face {
    font-family: 'Proposal Source Sans'; font-style: normal; font-weight: 400; font-display: swap;
    src: url('https://fonts.gstatic.com/s/sourcesans3/v19/nwpBtKy2OAdR1K-IwhWudF-R9QMylBJAV3Bo8Ky461EN.ttf') format('truetype');
  }
  @font-face {
    font-family: 'Proposal Lora'; font-style: normal; font-weight: 400; font-display: swap;
    src: url('https://fonts.gstatic.com/s/lora/v37/0QI6MX1D_JOuGQbT0gvTJPa787weuyJG.ttf') format('truetype');
  }
  @font-face {
    font-family: 'Proposal DM Serif'; font-style: normal; font-weight: 400; font-display: swap;
    src: url('https://fonts.gstatic.com/s/dmserifdisplay/v17/-nFnOHM81r4j6k0gjAW3mujVU2B2K_c.ttf') format('truetype');
  }
  @font-face {
    font-family: 'Proposal Cormorant'; font-style: normal; font-weight: 400; font-display: swap;
    src: url('https://fonts.gstatic.com/s/cormorantgaramond/v21/co3umX5slCNuHLi8bLeY9MK7whWMhyjypVO7abI26QOD_v86GnM.ttf') format('truetype');
  }
  @font-face {
    font-family: 'Proposal Fraunces'; font-style: normal; font-weight: 500; font-display: swap;
    src: url('https://fonts.gstatic.com/s/fraunces/v38/6NUh8FyLNQOQZAnv9bYEvDiIdE9Ea92uemAk_WBq8U_9v0c2Wa0K7iN7hzFUPJH58nib1603gg7S2nfgRYIchRujDg.ttf') format('truetype');
  }
  @font-face {
    font-family: 'Proposal Bodoni'; font-style: italic; font-weight: 400; font-display: swap;
    src: url('https://fonts.gstatic.com/s/bodonimoda/v28/aFT07PxzY382XsXX63LUYJSPUqb0pL6OQqxrZLnVbvZedvJtj-V7tIaZKMN4sQ.ttf') format('truetype');
  }
  * { box-sizing: border-box; letter-spacing: 0; }
  .proposal { min-height: 100svh; display: flex; flex-direction: column; padding: 0 max(2rem, calc((100% - 1120px) / 2)); font-family: Arial, sans-serif; color: var(--ink); background: var(--paper); }
  a { color: inherit; text-decoration: none; }
  a:hover { text-decoration: underline; text-underline-offset: 6px; }
  a:focus-visible { outline: 2px solid currentColor; outline-offset: 5px; }
  header { display: flex; align-items: center; justify-content: space-between; padding-block: 2rem; gap: 1rem; }
  nav { display: flex; gap: 2rem; font-size: 0.9rem; }
  header nav a { padding-block: 0.8rem; }
  .monogram { font-family: Georgia, serif; font-size: 2rem; font-style: italic; }
  main { flex: 1; display: flex; flex-direction: column; justify-content: center; padding-block: 4rem 6rem; }
  h1 { font-weight: 400; margin: 0; line-height: 0.95; }
  h1 > span { display: block; }
  p { margin: 2.5rem 0 0; font-size: 1rem; line-height: 1.7; }
  .employer { white-space: nowrap; }
  .period { display: none; }
  footer { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding-block: 1.5rem; }
  small { font-size: 0.75rem; }
  .contacts { gap: 0.4rem; }
  .contacts a { display: grid; place-items: center; width: 44px; height: 44px; }
  svg { width: 19px; height: 19px; fill: currentColor; }

  .literaria { --ink: #702b41; --paper: #fcfafb; }
  .literaria header { border-bottom: 1px solid #d7bfc7; }
  .literaria h1 { font-family: 'Proposal Cormorant', Georgia, serif; font-size: 8.5rem; }
  .literaria main { width: fit-content; align-self: center; }
  .literaria h1 > span:last-child { margin-left: 5rem; }
  .literaria p { color: #59484e; margin-left: 0.3rem; }
  .literaria footer { border-top: 1px solid #d7bfc7; }

  .grafica { --ink: #174d3e; --paper: #f3f6ef; }
  .grafica .monogram span { color: #ad472b; }
  .grafica main { display: grid; grid-template-columns: minmax(0, 1fr) 15rem; align-content: center; align-items: end; gap: 2rem; }
  .grafica h1 { font-family: 'Proposal Fraunces', Georgia, serif; font-weight: 500; font-size: 7.5rem; line-height: 1.05; }
  .grafica .period { display: inline; color: #ad472b; }
  .grafica p { padding: 0 0 0.5rem 1.5rem; border-left: 2px solid #ad472b; margin: 0; }
  .grafica .employer { display: block; }

  .delicada { --ink: #37353e; --paper: #fafafd; }
  .delicada .monogram { color: #8a4d83; font-weight: 400; }
  .delicada main { align-items: center; text-align: center; }
  .delicada h1 { font-family: 'Proposal Bodoni', 'Times New Roman', serif; font-style: italic; font-size: 5.5rem; line-height: 1.2; }
  .delicada h1 > span { display: inline; }
  .delicada p { color: #63576a; font-size: 0.9rem; }
  .delicada p::before { content: ''; display: block; width: 2rem; height: 1px; background: #a55c95; margin: 0 auto 1.8rem; }
  .delicada .contacts { color: #8a4d83; }

  .editorial { --ink: #302b31; --paper: #f8eef0; --accent: #b93649; }
  .editorial.humanista header nav, .editorial.humanista main p { font-family: 'Proposal Source Sans', Arial, sans-serif; }
  .editorial.classica header nav, .editorial.classica main p { font-family: 'Proposal Lora', Georgia, serif; }
  .company-link { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; }
  .editorial header { border-bottom: 1px solid #b58a95; justify-content: flex-end; }
  .editorial header nav { margin-left: auto; font-size: 1.25rem; }
  .editorial .home-link { color: var(--ink); font-family: 'Proposal DM Serif', Georgia, serif; font-size: 2.5rem; line-height: 1; min-width: 48px; min-height: 48px; display: flex; align-items: center; }
  .editorial .home-link span { color: var(--accent); }
  .editorial main {
    display: grid;
    grid-template-columns: max-content minmax(0, 21rem);
    justify-content: start;
    align-content: center;
    align-items: end;
    column-gap: 3rem;
  }
  .editorial h1 { font-family: 'Proposal DM Serif', Georgia, serif; font-size: 8rem; line-height: 1.02; }
  .editorial h1 > span:last-child { margin-left: 3rem; }
  .editorial .period { display: inline; color: var(--accent); }
  .editorial p { margin: 0 0 0.8rem; padding-top: 1rem; border-top: 2px solid var(--accent); color: #65535e; font-size: 1.375rem; }
  .editorial .employer { display: block; }
  .editorial a:hover { color: var(--accent); }
  .editorial footer { color: #65535e; }
  .editorial .contacts { color: var(--accent); }
  .editorial .contacts a { width: 48px; height: 48px; }
  .editorial .contacts svg { width: 26px; height: 26px; }
  .editorial small { font-size: 0.875rem; }

  @media (max-width: 1000px) {
    .editorial h1 { font-size: 6rem; }
    .editorial main { column-gap: 2rem; grid-template-columns: max-content minmax(0, 13rem); }
    .editorial h1 > span:last-child { margin-left: 1.5rem; }
    .grafica h1 { font-size: 6rem; }
    .grafica main { grid-template-columns: minmax(0, 1fr) 13rem; }
    .delicada h1 { font-size: 4.5rem; }
  }
  @media (max-width: 700px) {
    .editorial header nav { font-size: 1.125rem; gap: 1.25rem; }
    .editorial .home-link { font-size: 2.25rem; }
    .editorial p { font-size: 1.25rem; }
    .editorial main { display: flex; justify-content: center; align-items: flex-start; gap: 2.5rem; }
    .editorial h1 { font-size: 4.75rem; }
    .editorial h1 > span:last-child { margin-left: 0.75rem; }
    .editorial p { margin: 0; }
    .proposal { padding-inline: 1.5rem; }
    header { padding-block: 1.2rem; }
    header nav { gap: 1.4rem; }
    main { padding-block: 3rem 4rem; }
    .literaria h1 { font-size: 5.5rem; }
    .literaria h1 > span:last-child { margin-left: 1.5rem; }
    p { font-size: 0.9rem; max-width: 27ch; }
    .grafica main { display: flex; align-items: flex-start; gap: 2.5rem; }
    .grafica h1 { font-size: 4.75rem; }
    .grafica p { padding-bottom: 0; }
    .delicada h1 { font-size: 4rem; }
    .delicada h1 > span { display: block; }
    footer { flex-wrap: wrap; }
  }
  @media (max-width: 360px) {
    .editorial h1 { font-size: 4rem; }
    .literaria h1 { font-size: 4.5rem; }
    .grafica h1 { font-size: 4rem; }
    .delicada h1 { font-size: 3.5rem; }
  }
</style>
