---
import HomeProposal from '../components/HomeProposal.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Mafalda Ribeiro, Technical Program Manager at Cloudflare." />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={new URL('/', Astro.site).toString()} />
    <title>Mafalda Ribeiro</title>
  </head>
  <body>
    <HomeProposal variant="editorial" typography="classica" />
  </body>
</html>

<style is:global>
  html, body { margin: 0; background: #f8eef0; }
</style>
