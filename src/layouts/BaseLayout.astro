---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteAppearance from '../components/SiteAppearance.astro';

interface Props {
  title?: string;
  description?: string;
  minimal?: boolean;
  noIndex?: boolean;
}

const siteTitle = 'Mafalda Ribeiro';
const { title, description = 'Mafalda Ribeiro, Technical Program Manager at Cloudflare.', minimal = false, noIndex = false } = Astro.props;
const pageTitle = title ? `${title} · ${siteTitle}` : siteTitle;
---

<!doctype html>
<html lang="en" data-palette="coral">
  <head>
    <SiteAppearance />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).toString()} />
    <title>{pageTitle}</title>
  </head>
  <body class:list={{ 'minimal-home': minimal }}>
    <SiteHeader />
    <main>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
